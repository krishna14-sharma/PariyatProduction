<%@ Master Language="VB" CodeFile="ReportPage.master.vb" Inherits="ReportPage" %>
<%@ Register TagPrefix="app" Namespace="PoultryApp.Controls" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>MIS Reports | Phoenix Poultry</title>
    <link rel="icon" href="~/loginforms/images/icons/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link href="~/Content/app.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app">
    <script src="<%= ResolveUrl("~/Scripts/app.js") %>"></script>
    <div id="appProgress" class="app-progress"></div>

    <header class="app-header">
        <div class="app-brandbar">
            <a class="app-brand" href="~/Default_Mis.aspx" runat="server" title="Home">
                <img src="~/images/phoenix_logo.jpg" alt="Phoenix" runat="server" />
                <span class="app-module">MIS Reports</span>
            </a>
            <div class="app-user">
                <span class="app-avatar" aria-hidden="true"><%: UserInitial %></span>
                <span class="app-user-text">
                    <strong><%: CurrentUserName %></strong>
                    <small><%: CurrentLocation %></small>
                </span>
                <a class="app-signout" href="~/Logout.aspx" runat="server">Sign out</a>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg navbar-dark app-nav" aria-label="Main menu">
            <div class="container-fluid px-0">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appMenu" aria-controls="appMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="appMenu">
                <ul class="navbar-nav me-auto">               
                    
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Farm Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/misreports/mis_shedinformationreporttemp.aspx" runat="server">Shed Information (Temp)</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_shedreport.aspx" runat="server">Shed Wise Production</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_weelkyreport.aspx" runat="server">Weekly Report</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_DailyPMEntry.aspx" runat="server">PM Entry</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_flockdisesehistory.aspx" runat="server">Medication/Disease History</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_pmreport.aspx" runat="server">PM Report</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_consolidatePMreport.aspx" runat="server">PM (Consolidate)</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_flockprod_report.aspx" runat="server">Flock Production</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_floc_prod_consoli.aspx" runat="server">Flock Prod. (Consolidate)</a></li>
                              <li><a class="dropdown-item" href="~/misreports/mis_chicksperbird.aspx" runat="server">Chicks Per Bird</a></li>
                            <li><a class="dropdown-item" href="~/misreports/weekly_egg_data.aspx" runat="server">Weekly Egg (Shed Wise)</a></li> 
                            <li><a class="dropdown-item" href="~/misreports/WeeklyEggdata_comm.aspx" runat="server">Weekly Egg (Consolidated)</a></li>      
                            <li><a class="dropdown-item" href="~/misreports/weekly_stock_data.aspx" runat="server">Weekly Bird Stock</a></li> 
                            <li><a class="dropdown-item" href="~/misreports/weekly_flock_performance_rpt.aspx" runat="server">Flock Performance</a></li>
                            <li><a class="dropdown-item" href="~/misreports/FeedPerChick.aspx" runat="server">Feed per Chick</a></li>                                       
                        </ul>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Hatchery Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/misreports/mis_harch_hhereport.aspx" runat="server">Daily HHE Report</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_hatch_production_report.aspx" runat="server">Production Report</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_Hatchery_hatchablity_report.aspx" runat="server">Hatchery Hatchability</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_hatch_egg_stock.aspx" runat="server">Hatchery Egg Stock</a></li>
                            <li><a class="dropdown-item" href="~/misreports/mis_hatchery_comparaionreport.aspx" runat="server">Comparison Report</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="~/reports/Satellite_hatchert_hatachibilty_report.aspx" runat="server">Satellite Hatchery Report</a></li>
                        </ul>
                    </li> 

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Feed Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/feed/gatevehicleentry.aspx" runat="server">Gate Vehicle Entry</a></li>
                            <li><a class="dropdown-item" href="~/feed/inwregrep.aspx" runat="server">Inward Register</a></li>
                            <li><a class="dropdown-item" href="~/feed/rawstock.aspx" runat="server">Raw Stock</a></li>
                            <li><a class="dropdown-item" href="~/feed/finishfeedprod.aspx" runat="server">Finish Feed Production</a></li>
                            <li><a class="dropdown-item" href="~/feed/finishfeedstock.aspx" runat="server">Finish Feed Stock</a></li>
                            <li><a class="dropdown-item" href="~/feed/feedsalereport.aspx" runat="server">Area Transfer/Sale</a></li>
                        </ul>
                    </li> 
                <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            Vaccination Reports
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="../misreports/VaccinationSchedule.aspx">Vaccination Schedule</a></li>
                            </ul>
                    </li>
                    
                   </ul>
                </div>
            </div>
        </nav>
    </header>

    <form id="form1" runat="server">
        <%-- AJAX: partial rendering is switched off automatically on report-viewer / upload pages (see App_code/AppAjax.vb) --%>
        <app:AppScriptManager ID="AppScriptManager" runat="server" EnablePartialRendering="true" AsyncPostBackTimeout="3600" />

        <div id="appBusy" class="app-busy" aria-hidden="true">
            <div class="app-busy-box"><span class="app-spinner"></span>Please wait&hellip;</div>
        </div>

        <main class="app-main">
            <div class="container-xl">
                <asp:UpdatePanel ID="AppUpdatePanel" runat="server" UpdateMode="Always" ChildrenAsTriggers="true">
                    <ContentTemplate>
                        <div class="app-content">
                            <asp:ContentPlaceHolder ID="ReportMaster" runat="server">
                                <asp:Label ID="lblString" runat="server" />
                            </asp:ContentPlaceHolder>
                        </div>
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
        </main>
    </form>

    <footer class="app-footer">&copy; <%: DateTime.Now.Year %> Phoenix Group &middot; Poultry Management System</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>
