<%@ Master Language="VB" CodeFile="SiteMasterPit.master.vb" Inherits="SiteMasterPit" %>
<%@ Register TagPrefix="app" Namespace="PoultryApp.Controls" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pit Management | Phoenix Poultry</title>
    <link rel="icon" href="~/loginforms/images/icons/favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous" />
    <link href="~/Content/app.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="app">
    <script src="<%= ResolveUrl("~/Scripts/app.js") %>"></script>
    <div id="appProgress" class="app-progress"></div>

    <header class="app-header">
        <div class="app-brandbar">
            <a class="app-brand" href="~/Default_pit.aspx" runat="server" title="Home">
                <img src="~/images/phoenix_logo.jpg" alt="Phoenix" runat="server" />
                <span class="app-module">Pit Management</span>
            </a>
            <div class="app-user">
                <span class="app-avatar" aria-hidden="true"><%: UserInitial %></span>
                <span class="app-user-text">
                    <strong><%: CurrentUserName %></strong>
                    <small><%: CurrentLocation %></small>
                </span>
                <a class="app-signout" href="~/Logout.aspx" runat="server">Sign out</a>
            </div>
        </div>
        <nav class="navbar navbar-expand-lg navbar-dark app-nav" aria-label="Main menu">
            <div class="container-fluid px-0">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#appMenu" aria-controls="appMenu" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="appMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Transactions</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/pit/egg_recived.aspx" runat="server">Eggs Received from Hatchery</a></li>
                            <li><a class="dropdown-item" href="~/pit/bird_recived_pit.aspx" runat="server">Birds Received from Farm</a></li>
                            <li><a class="dropdown-item" href="~/pit/pit_egg_sale_destroy_distibute.aspx" runat="server">Eggs Sale / Destroy</a></li>
                            <li><a class="dropdown-item" href="~/pit/pit_bird_sale.aspx" runat="server">Birds Sale / Destroy</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="~/hatchery/hatchery_pit_egg_tfr.aspx" runat="server">Egg Transfer to Pit</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Reports</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/pit/pit_egg_coll_report.aspx" runat="server">Pit Egg Collection Report</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">MIS Pit</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="~/pit/pit_mis_itemname.aspx" runat="server">Item Master</a></li>
                            <li><a class="dropdown-item" href="~/pit/pit_mis_opening.aspx" runat="server">Item Opening Values</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" href="~/pit/pit_mis_receving.aspx" runat="server">Egg / Bird Receiving</a></li>
                            <li><a class="dropdown-item" href="~/pit/pit_mis_sale_destory.aspx" runat="server">Egg / Bird Sale / Destroy</a></li>
                        </ul>
                    </li>
                </ul>
                </div>
            </div>
        </nav>
    </header>

    <form id="form1" runat="server">
        <%-- AJAX: partial rendering is switched off automatically on report-viewer / upload pages (see App_code/AppAjax.vb) --%>
        <app:AppScriptManager ID="AppScriptManager" runat="server" EnablePartialRendering="true" AsyncPostBackTimeout="3600" />

        <div id="appBusy" class="app-busy" aria-hidden="true">
            <div class="app-busy-box"><span class="app-spinner"></span>Please wait&hellip;</div>
        </div>

        <main class="app-main">
            <div class="container-xl">
                <asp:UpdatePanel ID="AppUpdatePanel" runat="server" UpdateMode="Always" ChildrenAsTriggers="true">
                    <ContentTemplate>
                        <div class="app-content">
                            <asp:ContentPlaceHolder ID="SiteMasterPit" runat="server">
                                <asp:Label ID="lblString" runat="server" />
                                <hr class="divider" />
                            </asp:ContentPlaceHolder>
                        </div>
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
        </main>
    </form>

    <footer class="app-footer">&copy; <%: DateTime.Now.Year %> Phoenix Group &middot; Poultry Management System</footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
</body>
</html>
