<?xml version="1.0"?>
<!--
  Phoenix Poultry - ASP.NET Web Forms (.NET Framework 4.8) + ASP.NET AJAX + Crystal Reports 13.0.x
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=169433
-->
<configuration>
  <configSections>
    <sectionGroup name="businessObjects">
      <sectionGroup name="crystalReports">
        <section name="rptBuildProvider" type="CrystalDecisions.Shared.RptBuildProviderHandler, CrystalDecisions.Shared, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304, Custom=null"/>
      </sectionGroup>
    </sectionGroup>
  </configSections>
  <!--
    ALL database connections are configured here (they used to be hard-coded in App_code/*.vb).
    Change a server / password in ONE place.
      PoultryDb  -> main Poultry database        (GModule, GMod)
      FeedDb     -> Feed database                (GlobalModule)
      StoreDb    -> Store database               (GModule_Store)
      PoultryConnection, PoultryConnectionString, PoultryConnectionString1 -> used by the Graph Data Edit page
                    and by the DataSet (.xsd) files in App_code - kept for compatibility.
    SECURITY: use a dedicated SQL login with only the rights the site needs instead of "sa".
  -->
  <connectionStrings>
    <add name="PoultryDb" connectionString="Data Source=192.168.0.130,3759;Initial Catalog=Poultry;User ID=sa;Password=Ph@hoenix#g;Connect Timeout=60" providerName="System.Data.SqlClient"/>
    <add name="FeedDb" connectionString="Data Source=192.168.0.130,3759;Initial Catalog=phxfeed_2324;User ID=sa;Password=Ph@hoenix#g;Connect Timeout=60" providerName="System.Data.SqlClient"/>
    <add name="StoreDb" connectionString="Data Source=192.168.0.130;Initial Catalog=Pariyat_Store;User ID=sa;Password=Ph@hoenix#g;Connect Timeout=60" providerName="System.Data.SqlClient"/>
    <add name="PoultryConnection" connectionString="Data Source=192.168.0.130,3759;Initial Catalog=Poultry;User ID=sa;Password=Ph@hoenix#g;Connect Timeout=60" providerName="System.Data.SqlClient"/>
    <add name="PoultryConnectionString" connectionString="Data Source=PHXSERVER;Initial Catalog=Poultry;User ID=sa;Password=Ph@hoenix#g" providerName="System.Data.SqlClient"/>
    <add name="PoultryConnectionString1" connectionString="Data Source=192.168.0.150;Initial Catalog=Poultry;User ID=sa;Password=Ph@hoenix#g" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None"/>
    <!-- Crystal Reports image cleaner (removes old chart/picture temp files) -->
    <add key="CrystalImageCleaner-AutoStart" value="true"/>
    <add key="CrystalImageCleaner-Sleep" value="60000"/>
    <add key="CrystalImageCleaner-Age" value="120000"/>
    <!--
      ASP.NET AJAX (UpdatePanel in every master page).
        Ajax:PartialRendering  = "false" turns AJAX off for the whole site (instant rollback switch).
        Ajax:FullPostBackPages = pages that must always use full postbacks (Excel/file downloads etc.).
      Pages with a Crystal Reports viewer or a file upload are detected automatically.
    -->
    <add key="Ajax:PartialRendering" value="true"/>
    <add key="Ajax:FullPostBackPages" value="~/attendance/Muster_Report.aspx;~/misreports/mis_chicksperbird.aspx;~/misreports/mis_consolidatePMreport.aspx;~/attendance/uploadapplicationimage.aspx"/>
    <!-- Every page using a master page requires a signed-in user. Set to "false" to disable. -->
    <add key="Auth:RequireLogin" value="true"/>
    <!-- Original behaviour: only allow logins from Windows PCs. Set to "false" to allow phones/tablets. -->
    <add key="Login:WindowsOnly" value="true"/>
  </appSettings>
  <system.web>
    <!-- Users are signed in through Session("user_name") (see loginforms/index.aspx). -->
    <authentication mode="Forms">
      <forms loginUrl="~/loginforms/index.html" timeout="60" slidingExpiration="true"/>
    </authentication>
    <!-- 60 minute idle time-out (was the 20 minute default), so data entry is not lost so quickly. -->
    <sessionState mode="InProc" timeout="60"/>
    <!-- Set debug="true" only on a developer PC. debug="false" is faster and required for production. -->
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.8">
      <assemblies>
        <add assembly="CrystalDecisions.CrystalReports.Engine, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.ReportSource, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.Shared, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.ReportAppServer.ClientDoc, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.ReportAppServer.Controllers, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="CrystalDecisions.ReportAppServer.DataDefModel, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
        <add assembly="log4net, Version=1.2.10.0, Culture=neutral, PublicKeyToken=692FBEA5521E1304"/>
      </assemblies>
      <buildProviders>
        <add extension=".rpt" type="CrystalDecisions.Web.Compilation.RptBuildProvider, CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
      </buildProviders>
    </compilation>
    <!-- executionTimeout in seconds (applies when debug="false"): long-running reports may take up to 1 hour. -->
    <httpRuntime targetFramework="4.8" executionTimeout="3600" maxRequestLength="214748364" enableVersionHeader="false"/>
    <!-- Remote users see a friendly error page; on the server itself you still see full error details. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite"/>
    <!-- Classic-mode IIS / Visual Studio development server -->
    <httpHandlers>
      <add verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304"/>
    </httpHandlers>
  </system.web>
  <!-- Integrated-mode IIS (normal for IIS 7+) -->
  <system.webServer>
    <validation validateIntegratedModeConfiguration="false"/>
    <handlers>
      <add name="CrystalImageHandler.aspx_GET" verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" preCondition="integratedMode"/>
    </handlers>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By"/>
        <add name="X-Frame-Options" value="SAMEORIGIN"/>
      </customHeaders>
    </httpProtocol>
  </system.webServer>
  <businessObjects>
    <crystalReports>
      <rptBuildProvider>
        <add embedRptInResource="true"/>
      </rptBuildProvider>
    </crystalReports>
  </businessObjects>
</configuration>